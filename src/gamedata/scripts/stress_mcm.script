--------------------------------------------------------------------------------
-- Psy Stress Remake: presets move the sliders
-- Uses MCM's built-in "preset" option type (MCM 1.7.1+): selecting a preset
-- sets the listed sliders on the same page (pending until "Accept").
-- Older MCM versions show a plain list instead (sliders are then set by hand).
--------------------------------------------------------------------------------
-- original Psy Stress values (1x) and slider precision
local preset_base = {
	psy_damage_preset = { drain = {13, 0}, hit_stress = {2.8, 1}, wounded_stress = {14, 1} },
	psy_regen_preset  = { regen = {26, 1}, campfire_regen = {1.8, 2} },
}
-- text keys (recommended by MCM for presets): key = multiplier
local damage_multipliers = { {"uneasy", 3}, {"tense", 5}, {"harsh", 8}, {"brutal", 10}, {"nightmare", 15} }
local regen_multipliers = { {"steady", 1}, {"shaken", 0.7}, {"fragile", 0.3}, {"broken", 0.1} }
-- preset values that don't follow the multiplier
-- psy_anomaly_damage: % of base G.A.M.M.A. psy anomaly damage
local preset_fixed = {
	psy_damage_preset = {
		uneasy    = { controller_damage_multiplier = 30,  psy_anomaly_damage = 10 },
		tense     = { controller_damage_multiplier = 40,  psy_anomaly_damage = 20 },
		harsh     = { controller_damage_multiplier = 50,  psy_anomaly_damage = 35 },
		brutal    = { controller_damage_multiplier = 75,  psy_anomaly_damage = 45 },
		nightmare = { controller_damage_multiplier = 100, psy_anomaly_damage = 70 },
	},
}

local function round(x, prec)
	local m = 10 ^ prec
	return math.floor(x * m + 0.5) / m
end

local function build_presets(preset_id, multipliers)
	local presets = {}
	local fixed = preset_fixed[preset_id] or {}
	for _, entry in ipairs(multipliers) do
		local values = {}
		for key, data in pairs(preset_base[preset_id]) do
			values[key] = round(data[1] * entry[2], data[2])
		end
		for key, value in pairs(fixed[entry[1]] or {}) do
			values[key] = value
		end
		presets[entry[1]] = values
	end
	return presets
end

local damage_presets = build_presets("psy_damage_preset", damage_multipliers)
local regen_presets = build_presets("psy_regen_preset", regen_multipliers)

local function preset_type()
	-- get_gui() was added in MCM 1.7.1 together with the preset widget
	return (ui_mcm and ui_mcm.get_gui) and "preset" or "list"
end

