-----------UTILITY--------------------------------------------------------------
--Utility function for managing log and player messages.
local function printlog(msg,...)
	msg = msg or " "
	
	if select('#', ...) ~= 0 then printf(string.format(msg,...))
	else printf(msg)
	end
end


local function printdbg(msg,...)
-- printdbg wrapper for _g.printdbg, because it does not process formatted strings correctly.
	if not DEV_DEBUG then return end  --optimization: no string formatting when debug output is off
	msg = msg or " "
	
	if select('#', ...) ~= 0 then _g.printdbg(string.format(msg,...))
	else _g.printdbg(msg)
	end
end


local function printdbg_psy(forced, msg,...) -- debug logging
	if PSY_DEBUG and (debug_triggered or forced) then printlog(msg,...) end
end


local function printui(msg,...)
	msg = msg or " "
	
	if select('#', ...) ~= 0 then actor_menu.set_msg(1, string.format(msg,...),4)
	else actor_menu.set_msg(1, (msg),4)
	end
end


local function printnews(msg,...)
	msg = msg or " "
	
	if select('#', ...) ~= 0 then news_manager.send_tip(db.actor, string.format(msg,...), nil, nil, 10000)
	else news_manager.send_tip(db.actor, (msg), nil, nil, 10000)
	end
end


--old _message fuctions, preserved for compatiblity
function log_message(msg,...)
	--depricated and should not be used.
	--printf or printdbg from _g.script should be used instead.
	printdbg("arszy_psy.log_message() was called. It a local function and depricated, globaly available printf() or printdbg() should be used instead.")
	msg = msg or " "
	
	if select('#', ...) ~= 0 then printf(msg,...)
	else printf(msg)
	end
end


function show_message(msg,...)
	--depricated and should not be used.
	--actor_menu.set_msg should be used instead.
	printdbg("arszy_psy.show_message() was called. It is a local function and depricated, actor_menu.set_msg() should be used instead.")
	msg = msg or " "
	
	if select('#', ...) ~= 0 then printui(msg,...)
	else printui(msg)
	end
end


function show_message_news(msg,...)
	--depricated and should not be used.
	--news_manager.send_tip should be used instead.
	printdbg("arszy_psy.show_message_news() was called. It is a local function and depricated, news_manager.send_tip() should be used instead.")
	msg = msg or " "
	
	if select('#', ...) ~= 0 then printnews(msg,...)
	else printnews(msg)
	end
end


function trace_this(to_trace)
	--function is empty and never used. kept to maintain compatiblity, just in case.
end


--Utility functions to get player and game states.
function is_actor_zombied()
	return db.actor:character_community() == "actor_zombied"
end


function is_controller(obj)
	return obj:clsid() == clsid.controller_s
end


function get_distance(position_1, position_2)
	--public due to being from the original script
	local distance = 9999
	
	if position_1 and position_2 then
		distance = position_1:distance_to(position_2)
	end

	return distance
end


local function is_in_action()
	return is_not_empty(xr_combat_ignore.fighting_with_actor_npcs) or false
end


function get_ppe_audio_intensity()
	local health_factor = 1 - get_psy_health()
	
	return health_factor * c_ppe_audio_max_intensity
end


--Compatibility (Psy Stress Remake): other GAMMA mods (e.g. "Phantoms at low psy health" + "Maybelline's Restore XCV phantoms")
--read psy health from this function and expect the scale of G.A.M.M.A. Psy rework: (1 - psy health) * 0.01.
--Psy Stress itself does not use it.
local c_gamma_ppe_max_intensity = 0.01
function get_ppe_intensity()
	return (1 - get_psy_health()) * c_gamma_ppe_max_intensity
end


--Special funtion to recalculate Controller psy-attack damage
function get_controller_tube_damage(obj_position, power)
	if not (obj_position and power ) then return 0 end
	local distance = get_distance(db.actor:position(), obj_position)
	--replaces wierd calcaulation from orginal ANOMALY arzi_psy
	--linear scale from max distance to 0.1 of max distance
	--so if distance is 120 meters, closer than 12 meters there would be full damage, 50% at 66m, 0.9% at 129 and 0 at 120
	local damage = power * (c_controller_damage_max_distance - distance) / (0.9 * c_controller_damage_max_distance)
	
	damage = clamp(damage, 0, power)
	return damage
end


--Psy anomalies (Psy Stress Remake): psy hits whose source is an anomaly zone (psy fields and other psy anomalies),
--plus the psy aura of Dynamic Anomalies Overhaul / Arrival (see psy_stress_dao_patch.script).
--Psy emitters (Brain Scorcher, X16, Radar), psi-storms and mutants are not anomalies.
local function is_psy_anomaly_source(obj)
	if not obj then return false end
	if IsAnomaly and IsAnomaly(obj) then return true end
	local sec = obj:section()
	if sec and string.find(sec, "^zone_") then return true end
	--the DAO / Arrival psy aura hits with the actor as the source; it is counted while the aura is active
	local actor = db.actor
	if actor and obj:id() == actor:id() then
		local dao = psy_stress_dao_patch
		return dao and dao.is_aura_active and dao.is_aura_active() or false
	end
	return false
end

function is_psy_anomaly_hit(s_hit)
	if not (s_hit and s_hit.type == hit.telepatic) then return false end
	return is_psy_anomaly_source(s_hit.draftsman)
end

--Direct psy damage of the DAO / Arrival psy aura (called by psy_stress_dao_patch.script), scaled by the slider
function change_psy_health_anomaly(amount)
	if type(amount) ~= "number" or not db.actor or is_actor_zombied() then return end
	if amount < 0 then amount = amount * c_psy_anomaly_damage_multiplier end
	change_psy_health(amount)
end

--true when G.A.M.M.A. Actor Damage Balancer applies psy anomaly damage through psy_stress_gamma_hit_patch
local function gamma_balancer_handles_anomaly_psy()
	local patch = psy_stress_gamma_hit_patch
	return patch and patch.handles_anomaly_psy and patch.handles_anomaly_psy() or false
end

--Called by psy_stress_gamma_hit_patch for psy anomaly hits: G.A.M.M.A.'s Actor Damage Balancer calculates the
--base G.A.M.M.A. damage (its own psy protection and difficulty), Psy Stress scales it with the MCM slider.
function apply_gamma_anomaly_psy_hit(base_booster, s_hit, ...)
	if not db.actor or is_actor_zombied() then return end
	local psy_now = get_psy_health()
	psy_table.actor_psy_health = psy_now  --the balancer subtracts its damage from this value
	base_booster(s_hit, ...)
	local after = psy_table.actor_psy_health
	local gamma_damage = (type(after) == "number") and math.max(psy_now - after, 0) or 0
	local damage = gamma_damage * c_psy_anomaly_damage_multiplier
	if PSY_DEBUG then printdbg_psy(true, "psy anomaly hit: G.A.M.M.A. damage %f x%.2f = %f", gamma_damage, c_psy_anomaly_damage_multiplier, damage) end
	set_psy_health(psy_now - damage)
end


function actor_on_feeling_anomaly(obj, flags)
	--dynamic anomaly detection
	psy_env_state.anomaly_sense = obj and true or false
end


--Utility functions to manage psy health
function get_psy_health()
	local actor = db.actor
	if not actor then return psy_table.actor_psy_health or 1 end  --other mods may ask before the actor exists (main menu, level loading)
	local engine_psy = actor.psy_health
	local table_psy = psy_table.actor_psy_health or engine_psy  --safe if another mod calls this before on_game_load
	local psy_health = ( engine_psy < table_psy ) and engine_psy or table_psy
	
	if PSY_DEBUG then printdbg_psy(false, "psy_health %f | psy_table %f | db.actor %f", psy_health, table_psy, engine_psy) end
	return psy_health
end


function set_psy_health(value)
	if not db.actor then return end  --other mods may call this before the actor exists
	value = value and value or get_psy_health()
	psy_table.actor_psy_health = clamp(value, 0 , 1)
	db.actor.psy_health = clamp(psy_table.actor_psy_health, 0.01, 1)
	
	if PSY_DEBUG then printdbg_psy(false, "value %f | psy_table %f | db %f", value, psy_table.actor_psy_health, db.actor.psy_health) end
end


-- code equivalent to demonized's
function change_psy_health(amount)
	set_psy_health((psy_table.actor_psy_health or get_psy_health()) + amount)
	
	if PSY_DEBUG then printdbg_psy(true, "psy changed by %f", amount) end
end
-- code equivalent end


