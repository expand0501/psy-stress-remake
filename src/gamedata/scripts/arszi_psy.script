local c_psy_wound_stress_multiplier = ( stress_mcm.get_config("wounded_stress") or 112 ) / 600000                   --multiplier for stress drain from not being at full physical health

--PRESETS (Psy Stress Remake)-------------------------------------------------
--MCM presets move the sliders (see stress_mcm.script), so drain/hit/wound/regen are read from the sliders directly.
--Recovery sources without a slider (psy boosters, artefacts, sleep and surge cover recovery)
--follow the basic regeneration slider relative to its original value (26).
local c_psy_regen_original = 26
local c_psy_recovery_base_per_second = 13 / 2160000   --original basic drain, used for sleep / surge cover recovery
local function get_regen_ratio()
	return math.max(( stress_mcm.get_config("regen") or c_psy_regen_original ) / c_psy_regen_original, 0)
end
local psy_regen_ratio = get_regen_ratio()


